Options -Indexes
DirectoryIndex index.php

RewriteEngine On

# Reject unsafe HTTP methods.
RewriteCond %{REQUEST_METHOD} ^(?:TRACE|TRACK|DEBUG)$ [NC]
RewriteRule ^ - [F,L]

# Reject path traversal attempts in the request path or query string.
RewriteCond %{THE_REQUEST} \s/+.*(?:\.\./|\.\.\\) [NC,OR]
RewriteCond %{QUERY_STRING} (^|[&=])(?:\.\./|\.\.\\) [NC]
RewriteRule ^ - [F,L]

# Block direct web access to backend-only folders and service internals.
RewriteRule ^(?:config|security|sql|scripts|vendor|flask_app)(?:/|$) - [F,L,NC]
RewriteRule ^api/(?:node_modules|middleware|routes)(?:/|$) - [F,L,NC]
RewriteRule ^api/server\.js$ - [F,L,NC]

# Block direct web access to private upload storage.
RewriteRule ^storage/(?:case_files|documents|messages|payment_proofs|payment_qr)(?:/|$) - [F,L,NC]

# Force HTTPS outside local development.
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^(?:localhost|127\.0\.0\.1)(?::\d+)?$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Block sensitive project files from direct download.
<FilesMatch "(^\.env(?:\..*)?$|^\.git|^\.htaccess$|composer\.(?:json|lock)$|package(?:-lock)?\.json$|README\.txt$|.*\.(?:sql|bak|backup|old|orig|log|ini|yml|yaml|md)$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self' https: data:; script-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com 'unsafe-inline'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' http://127.0.0.1:3001 https://lexshieldguru.onrender.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>
